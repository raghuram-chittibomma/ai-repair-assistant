# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/INFRASTRUCTURE.md and ADR-0006 / ADR-0008 / ADR-0009.

# --- Compose (docker/compose.yaml) ---
POSTGRES_USER=repair
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repair_assistant
# Host port on the LAN Docker host mapped to container 5432 (must be free).
HOST_PORT=5436

# --- App / repair-corpus ingest ---
# Replace DOCKER_HOST with the LAN hostname or IP from INFRASTRUCTURE.local.md.
DATABASE_URL=postgresql://repair:change-me@DOCKER_HOST:5436/repair_assistant

# Local open-source embeddings (zero inference cost after model download).
# OpenAI is not used for embeddings — reserved for LLM inference later.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMS=768
# Optional: persist / reuse the BGE download. The API image uses
# HF_HOME=/home/app/.cache/huggingface. Set HF_HUB_OFFLINE=1 for local_files_only.
# HF_HOME=
# HF_HUB_OFFLINE=

# --- Phase 5 grounded Q&A (OpenAI inference only) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Bound OpenAI complete/stream calls (seconds). API returns HTTP 504 on timeout.
LLM_TIMEOUT_SECONDS=120
# Transient failures (429 / 5xx / connection): total attempts, not extra retries.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.5
# Generation hygiene (review R25). Transcript windowing is not this knob.
LLM_MAX_TOKENS=2048

# --- Phase 10 HTTP API ---
# Default bind is loopback. Set REPAIR_API_HOST=0.0.0.0 only for an explicit LAN bind.
REPAIR_API_KEY=
REPAIR_API_HOST=127.0.0.1
REPAIR_API_PORT=8080
# Host port mapped to the API container (Compose); bind on LAN host only.
API_PORT=8080
# In-memory diagnose sessions (not durable across API restart).
REPAIR_SESSION_TTL_SECONDS=3600
REPAIR_SESSION_MAX=32
# Per-session diagnose turns (not a spend ceiling). Start a new chat after this.
REPAIR_SESSION_MAX_TURNS=24
REPAIR_DB_POOL_SIZE=4
# Max seconds to wait for a free pool connection (then HTTP 503).
REPAIR_DB_POOL_TIMEOUT_SECONDS=30
# Set to 1 in tests to skip BGE warmup at API startup.
REPAIR_SKIP_EMBEDDER_WARMUP=

# Optional override for Langfuse app_git_sha stamp (default: git rev-parse --short HEAD).
# REPAIR_APP_GIT_SHA=

# --- Phase 9 Langfuse tracing (optional — leave empty to disable) ---
# Self-host on laptop: docs/LANGFUSE.md → http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Max characters per trace field (prompts, evidence, LLM I/O). Default 12000.
# REPAIR_TRACE_MAX_CHARS=12000
